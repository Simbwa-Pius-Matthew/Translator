rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /translationUsage/{document} {
      allow read, write: if false;
    }
    match /translationRequests/{document} {
      allow read, write: if false;
    }
    match /users/{userId} {
      allow read, write: if false;
    }
  }
}